{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backdrop-augmentation-protocol.github.io/spec/drafts/0.2.0/schemas/component-properties.schema.json",
  "title": "Wallpaper Engine Property Projection for BAPC",
  "description": "Normalized projection of project.json general.properties. This is not a required package sidecar and excludes Wallpaper Engine's current user-selected values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "properties"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "properties": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/property" }
    }
  },
  "$defs": {
    "property": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["bool", "color", "slider", "combo", "textinput", "file", "directory"] },
        "value": {},
        "text": { "type": "string", "maxLength": 256 },
        "order": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "fraction": { "type": "integer", "minimum": 0, "maximum": 8 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 8 },
        "options": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "condition": { "type": "string", "maxLength": 1024 }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "bool" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "color" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "slider" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "number" }, "min": { "type": "number" }, "max": { "type": "number" } } } },
        { "if": { "properties": { "type": { "const": "combo" } } }, "then": { "required": ["value", "options"] } },
        { "if": { "properties": { "type": { "const": "textinput" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "string" } } } }
      ]
    }
  }
}
