{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backdrop-augmentation-protocol.github.io/spec/profiles/we-web-workshop/project.schema.json",
  "title": "BAP Wallpaper Engine Web distribution metadata (minimum)",
  "type": "object",
  "required": ["type", "file", "title", "preview"],
  "properties": {
    "type": { "type": "string", "pattern": "^[Ww][Ee][Bb]$" },
    "file": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "preview": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "general": { "type": "object" },
    "workshopid": { "type": "string", "pattern": "^[0-9]+$" }
  },
  "additionalProperties": true
}
