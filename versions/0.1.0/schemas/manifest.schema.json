{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backdrop-augmentation-protocol.github.io/spec/versions/0.1.0/schemas/manifest.schema.json",
  "title": "BAP Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "id", "name", "version", "role", "capabilities", "entrypoints"],
  "properties": {
    "protocol": {"$ref": "common.schema.json#/$defs/protocol"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "implementationVersion": {"$ref": "common.schema.json#/$defs/semver"},
    "role": {"$ref": "common.schema.json#/$defs/role"},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"}},
    "modes": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/mode"}},
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {"type": "string", "minLength": 1},
        "standalone": {"type": "string", "minLength": 1},
        "embedded": {"type": "string", "minLength": 1}
      }
    },
    "configScopes": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/scope"}},
    "description": {"type": "string", "maxLength": 2048}
  },
  "allOf": [
    {"if": {"required": ["role"], "properties": {"role": {"const": "component"}}}, "then": {"required": ["modes"], "allOf": [
      {"if": {"properties": {"modes": {"type": "array", "contains": {"const": "standalone"}}}}, "then": {"properties": {"entrypoints": {"type": "object", "properties": {"standalone": {"type": "string", "minLength": 1}}, "required": ["standalone"]}}}},
      {"if": {"properties": {"modes": {"type": "array", "contains": {"const": "embedded"}}}}, "then": {"properties": {"entrypoints": {"type": "object", "properties": {"embedded": {"type": "string", "minLength": 1}}, "required": ["embedded"]}}}}
    ]}}
  ]
}
